FROM ubuntu:26.04

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash ca-certificates coreutils curl git openssh-client \
        python3 python3-venv tar \
    && rm -rf /var/lib/apt/lists/*

# The series tag moves; reject a different point release rather than silently
# testing another Ubuntu version.
RUN python3 -c 'import platform; release = platform.freedesktop_os_release(); print(release["PRETTY_NAME"]); assert release["VERSION"].split()[0] == "26.04.1", "Expected Ubuntu 26.04.1"'

RUN useradd --create-home --uid 1001 --shell /bin/bash vmtest
USER vmtest
WORKDIR /home/vmtest/project

COPY --chown=vmtest:vmtest requirements.txt ./
RUN python3 -m venv .venv \
    && .venv/bin/python -m pip install --no-cache-dir -r requirements.txt

COPY --chown=vmtest:vmtest setup_vm.py tool_installers.py ./
COPY --chown=vmtest:vmtest tests/ tests/
RUN .venv/bin/python -m unittest discover -s tests -v

ENV PATH="/home/vmtest/.local/bin:/home/vmtest/project/.venv/bin:${PATH}"
CMD ["bash"]
